    <!-- Onboarding Screen 1 (Introduction) -->
    <string name="onboarding_step1_chap">VOLUME I — CAPITOLO 01</string>
    <string name="onboarding_step1_badge">LUCE MATTUTINA</string>
    <string name="onboarding_step1_quote">«Come un sussurro silenzioso...»</string>
    <string name="onboarding_step1_intro">NOTA INTRODUTTIVA</string>
    <string name="onboarding_step1_intro_sub">APERTURA</string>
    <string name="onboarding_step1_title">Ogni gatto ha una storia.</string>
    <string name="onboarding_step1_title_part1">Ogni gatto ha una </string>
    <string name="onboarding_step1_title_highlight">storia</string>
    <string name="onboarding_step1_title_part2">.</string>
    <string name="onboarding_step1_desc">Meowoirs è il tuo spazio personale per conservare i piccoli momenti, le foto e le storie che condividi con i tuoi gatti.</string>
    <string name="onboarding_step1_feature_title">Crea il tuo archivio personale</string>
    <string name="onboarding_step1_feature_desc">Costruisci il tuo archivio di ricordi con foto, appunti e piccoli momenti.</string>
    <string name="onboarding_step1_footer1">ARCHIVIO MEOWOIRS</string>
    <string name="onboarding_step1_footer2">PRIMA PAGINA</string>

    <!-- Onboarding Screen 2 (Memories) -->
    <string name="onboarding_step2_chap">CAPITOLO II — FRAMMENTI DI DIARIO</string>
    <string name="onboarding_step2_title">Conserva i piccoli momenti.</string>
    <string name="onboarding_step2_subtitle">Una foto, poche parole e il sentimento di quel momento.</string>
    <string name="onboarding_step2_badge1">ANNO. 128</string>
    <string name="onboarding_step2_badge2">08:45 Sonno mattutino</string>
    <string name="onboarding_step2_date">14 Ottobre</string>
    <string name="onboarding_step2_mood">Pacifico</string>
    <string name="onboarding_step2_quote">“Raggomitolato sulla coperta di lana mentre bevevo il mio caffè mattutino. Così calmo come se il mondo si fosse fermato...”</string>
    <string name="onboarding_step2_editorial_text">Meowoirs trasforma i momenti ordinari in piccole storie che non vorrai dimenticare.</string>
    <string name="onboarding_step2_footer1">ARCHIVIO PERSONALE</string>
    <string name="onboarding_step2_footer2">PICCOLI MOMENTI</string>

    <!-- Onboarding Screen 3 (Cats & Stories) -->
    <string name="onboarding_step3_chap">CAPITOLO III — NELLA TUA STORIA</string>
    <string name="onboarding_step3_title">Ogni gatto può far parte della tua storia.</string>
    <string name="onboarding_step3_desc">Dal gatto in casa tua a un amico incontrato per strada, conserva i piccoli momenti che toccano la tua vita.</string>
    <string name="onboarding_step3_home_badge">A CASA</string>
    <string name="onboarding_step3_home_title">La storia della nostra casa</string>
    <string name="onboarding_step3_street_badge">STORIA DI STRADA</string>
    <string name="onboarding_step3_street_title">Spirito della strada</string>
    <string name="onboarding_step3_street_subtitle">Olive — Vecchio amico del quartiere</string>
    <string name="onboarding_step3_feature_title">A casa o per strada</string>
    <string name="onboarding_step3_feature_desc">Includi i gatti della tua casa o quelli che incontri per strada nella tua storia.</string>
    <string name="onboarding_step3_footer1">ARCHIVIO MEOWOIRS</string>
    <string name="onboarding_step3_footer2">OGNI GATTO</string>

