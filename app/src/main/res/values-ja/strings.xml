    <string name="onboarding_step3_feature_title">家でも街でも</string>
    <string name="onboarding_step3_feature_desc">あなたの家の猫や通りで出会う猫を、あなた自身の物語に含めてください。</string>
    <string name="onboarding_step3_footer1">MEOWOIRSアーカイブ</string>
