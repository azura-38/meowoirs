    <string name="onboarding_step1_title_highlight">物語</string>
    <string name="onboarding_step1_title_part2">があります。</string>
    <string name="onboarding_step1_desc">Meowoirsは、猫と共有する小さな瞬間、写真、物語を保管するための個人的なスペースです。</string>
    <string name="onboarding_step1_feature_title">個人アーカイブを作成</string>
