    <!-- Onboarding Screen 2 (Memories) -->
    <string name="onboarding_step2_chap">第II章 — 日記の断片</string>
    <string name="onboarding_step2_title">小さな瞬間を保管する。</string>
    <string name="onboarding_step2_subtitle">写真、いくつかの言葉、そしてその瞬間の気持ち。</string>
    <string name="onboarding_step2_badge1">ANNO. 128</string>
    <string name="onboarding_step2_badge2">08:45 朝の眠り</string>
    <string name="onboarding_step2_date">10月14日</string>
    <string name="onboarding_step2_mood">平和</string>
    <string name="onboarding_step2_quote">“朝のコーヒーを飲みながらウールの毛布にくるまっていた。まるで世界が止まったかのように穏やか...”</string>
    <string name="onboarding_step2_editorial_text">Meowoirsは、普通の瞬間を忘れたくない小さな物語に変えます。</string>
    <string name="onboarding_step2_footer1">個人アーカイブ</string>
    <string name="onboarding_step2_footer2">小さな瞬間</string>

    <!-- Onboarding Screen 3 (Cats & Stories) -->
    <string name="onboarding_step3_chap">第III章 — あなたの物語の中で</string>
    <string name="onboarding_step3_title">すべての猫があなたの物語の中にいることができます。</string>
    <string name="onboarding_step3_desc">家にいる猫から道で出会った友達まで、あなたの人生に触れる小さな瞬間を保管してください。</string>
    <string name="onboarding_step3_home_badge">家で</string>
    <string name="onboarding_step3_home_title">私たちの家の物語</string>
