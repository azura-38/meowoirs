    <string name="onboarding_step1_title_part2">.</string>
    <string name="onboarding_step1_desc">Meowoirs ist Ihr persönlicher Raum, um die kleinen Momente, Fotos und Geschichten aufzubewahren, die Sie mit Ihren Katzen teilen.</string>
