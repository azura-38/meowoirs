<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MeowoirsApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_meowoirs_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_meowoirs_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meowoirs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@drawable/ic_meowoirs_logo"
            android:roundIcon="@drawable/ic_meowoirs_logo"
            android:theme="@style/Theme.Meowoirs"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google AdMob Application ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-587701117866406~4355156867" />

        <!-- Disable automatic MobileAdsInitProvider to prevent startup validation crash -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:node="remove" />
    </application>

</manifest>
